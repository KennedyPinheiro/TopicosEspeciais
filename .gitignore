# ============================
#  GITIGNORE COMPLETO DO PROJETO
# ============================

# ----------------------------
# PHP / Laravel
# ----------------------------
vendor/
composer.lock
.env
.env.*
*.log

# Cache e builds
bootstrap/cache/*
!bootstrap/cache/.gitignore
storage/*
!storage/app/.gitignore
!storage/framework/.gitignore
!storage/logs/.gitignore

# ----------------------------
# Node / Vite / Frontend
# ----------------------------
node_modules/
dist/
build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Arquivos temporários do Vite
*.local
vite.config.timestamp*
.vite/

# ----------------------------
# Docker
# ----------------------------
# Volumes montados
docker/mysql/data/
docker/mysql/data/*

# Logs
docker/*.log
*.pid

# Pastas criadas pelos containers
**/mysql/
**/data/
**/db_data/

# ----------------------------
# Sistema operacional
# ----------------------------
.DS_Store
Thumbs.db

# ----------------------------
# IDEs
# ----------------------------
.vscode/
.idea/

# ----------------------------
# Cache geral
# ----------------------------
*.cache
*.tmp
*.temp

